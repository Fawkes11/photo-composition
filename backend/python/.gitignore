# Entorno y pesos de los modelos: cientos de MB, se reinstalan con pip.
.venv/
__pycache__/
*.pyc

# ── Las fotos del bake-off NO van al repositorio ──
#
# Son fotos de personas reales e identificables, sacadas de redes sociales.
# El repositorio es público y su sitio de GitHub Pages también, así que
# commitearlas las volvería a publicar bajo otro dominio, sin que esas personas
# lo sepan ni lo hayan consentido. Se quedan en local.
#
# Lo mismo para la salida: los recortes contienen las mismas caras.
bakeoff/input/
bakeoff/salida/
