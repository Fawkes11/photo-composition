# Configuración de Apache para servir el kiosco desde cPanel.
#
# Este archivo va en /public para que Vite lo copie a dist/ en cada build. Tiene
# que acabar en la raíz del subdominio, junto a index.html.

# ── LO IMPRESCINDIBLE ────────────────────────────────────────────────
#
# MediaPipe carga su WebAssembly con `instantiateStreaming`, que EXIGE que el
# servidor responda `Content-Type: application/wasm`. Apache no conoce la
# extensión .wasm por defecto y la sirve como octet-stream: entonces la carga
# falla y el kiosco se queda sin segmentación, normalmente sin un error claro.
#
# Es la causa número uno de que esto no funcione al subirlo a un hosting
# compartido.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  # Los .tflite son binarios opacos; se declaran para que ningún módulo del
  # servidor intente interpretarlos o reescribirlos.
  AddType application/octet-stream .tflite
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType image/svg+xml .svg
</IfModule>

# ── COMPRESIÓN ───────────────────────────────────────────────────────
#
# El bundle baja de 267 KB a ~87 KB. NO se comprimen el wasm ni los modelos:
# ya están comprimidos y volver a hacerlo solo gasta CPU del servidor en cada
# descarga sin ganar nada.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── CACHÉ ────────────────────────────────────────────────────────────
#
# Los archivos de /assets/ llevan un hash en el nombre: si cambia el contenido,
# cambia el nombre. Se pueden cachear para siempre sin riesgo de servir una
# versión vieja.
#
# El index.html NO se cachea: es quien apunta a los assets nuevos, y si el
# navegador se queda con uno viejo seguiría cargando el kiosco anterior tras
# cada actualización.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType application/octet-stream "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|wasm|tflite|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── HTTPS OBLIGATORIO ────────────────────────────────────────────────
#
# Sin HTTPS el navegador bloquea getUserMedia y el kiosco no puede abrir la
# cámara. No es una preferencia: es un requisito para que la app funcione.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── VARIOS ───────────────────────────────────────────────────────────

# Sin listados de directorio: nadie tiene por qué ver el contenido de /images
# o /models navegando a esas carpetas.
Options -Indexes
